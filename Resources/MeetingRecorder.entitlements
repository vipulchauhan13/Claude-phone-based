<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for microphone access when the hardened runtime is enabled (Developer ID / notarized builds). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Not sandboxed: direct distribution. For the Mac App Store add com.apple.security.app-sandbox
         and com.apple.security.files.user-selected.read-write, and save through NSSavePanel. -->
</dict>
</plist>
